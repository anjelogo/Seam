ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERCEPTRON_API_KEY=
FAL_KEY=
EBAY_APP_ID=
EBAY_CERT_ID=
GEN3D_URL=http://localhost:8001
API_URL=http://localhost:8000
DATA_DIR=../data
VERCEL_ORIGIN=
WEB_PORT=5273
GEN3D_BACKEND=mock
ASSETS_DIR=

# compose overrides the host to @postgres:5432
DATABASE_URL=postgresql://seam:seam@localhost:5432/seam
POSTGRES_PASSWORD=seam
# comma list, checked against the Origin header
PUBLIC_ORIGINS=http://localhost:5273
# true in prod
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
# comma list of emails that can open /admin; empty = nobody
ADMIN_EMAILS=
# cloudflare dashboard tunnel (public hostname -> http://web:80), also add its https origin to PUBLIC_ORIGINS; empty = quick tunnel
TUNNEL_TOKEN=

# scrape infra, all optional; empty = direct, no challenge solving, no rotation
# in-stack VPN: --profile vpn with provider settings in gluetun.env, then SCRAPE_PROXY=http://gluetun:8888 GLUETUN_CONTROL_URL=http://gluetun:8000
# home-server instead: SCRAPE_PROXY=http://<ip>:8888, FLARESOLVERR_URL=http://<ip>:8191/v1, GLUETUN_CONTROL_URL=http://<ip>:8000
# GLUETUN_CONTROL_AUTH="user:pass" or api key, only if that control server requires it
SCRAPE_PROXY=
FLARESOLVERR_URL=
GLUETUN_CONTROL_URL=
GLUETUN_CONTROL_AUTH=
# false while the gluetun also fronts other apps (the home-server one fronts qBittorrent); the in-stack one is Seam's alone
GLUETUN_ROTATE=false
SCRAPE_CONCURRENCY_PER_SOURCE=3
SCRAPE_MIN_INTERVAL_MS=500
SCRAPE_QUERIES=vintage,y2k,grunge,streetwear,workwear,minimalist,denim,leather,90s,carhartt
SCRAPE_PAGES=1
# UTC; 2am Pacific
SCRAPE_CRON="0 9 * * *"
STALE_HOURS=72
# each tag job peaks ~11.5 GB RAM (birefnet + SAM cutout); raise only with ~12 GB free per extra job
CV_CONCURRENCY=1
