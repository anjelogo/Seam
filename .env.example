ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERCEPTRON_API_KEY=
FAL_KEY=
EBAY_APP_ID=
EBAY_CERT_ID=
GEN3D_URL=http://localhost:8001
API_URL=http://localhost:8000
DATA_DIR=../data
VERCEL_ORIGIN=
WEB_PORT=5273
GEN3D_BACKEND=mock
ASSETS_DIR=

# compose overrides the host to @postgres:5432
DATABASE_URL=postgresql://seam:seam@localhost:5432/seam
POSTGRES_PASSWORD=seam
# comma list, checked against the Origin header
PUBLIC_ORIGINS=http://localhost:5273
# true in prod
COOKIE_SECURE=false
SESSION_TTL_DAYS=30

# home-server scrape infra, all optional; empty = direct, no challenge solving, no rotation
# SCRAPE_PROXY=http://<home-server-ip>:8888 (gluetun http proxy), FLARESOLVERR_URL=http://<home-server-ip>:8191/v1
# GLUETUN_CONTROL_URL=http://<home-server-ip>:8000, GLUETUN_CONTROL_AUTH="user:pass" or api key if required
SCRAPE_PROXY=
FLARESOLVERR_URL=
GLUETUN_CONTROL_URL=
GLUETUN_CONTROL_AUTH=
# that gluetun also fronts qBittorrent, so rotation stays off unless you mean it
GLUETUN_ROTATE=false
SCRAPE_CONCURRENCY_PER_SOURCE=3
SCRAPE_MIN_INTERVAL_MS=500
SCRAPE_QUERIES=vintage,y2k,grunge,streetwear,workwear,minimalist
SCRAPE_PAGES=1
# UTC; 2am Pacific
SCRAPE_CRON="0 9 * * *"
STALE_HOURS=72
CV_CONCURRENCY=4
